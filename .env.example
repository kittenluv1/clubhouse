# Copy to .env.local and fill in. Use the *development* Supabase project
# locally (see docs/environments.md).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Account allowed into /admin
NEXT_PUBLIC_ADMIN_EMAIL=

# Google sign-in
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only. Review emails are skipped unless both are set. EMAIL_FROM must be
# on a domain verified in Resend, e.g. Clubhouse <noreply@clubhouseucla.com>
RESEND_API_KEY=
EMAIL_FROM=

# Base URL for links in emails. Optional on Vercel, which falls back to the
# production domain; locally it defaults to http://localhost:3000
SITE_URL=

# PostHog analytics (optional; server-side capture is off without a token)
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Shared secret Vercel cron sends to /api (club sync). Any long random string;
# generate one with: openssl rand -hex 32
CRON_SECRET=
